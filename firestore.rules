rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isKitchenStaff() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.kitchenStaff == true;
    }

    function isGuestOrder() {
      return request.resource.data.userId == 'guest' || 
             request.resource.data.userId.matches('^guest_.*');
    }

    // Allow test orders for unauthenticated users (for testing Phase 4)
    function isTestOrder() {
      // Check if userId exists and matches pattern, safe navigation
      return request.resource.data.keys().hasAll(['userId']) && 
             request.resource.data.userId.matches('^test-user-.*');
    }

    // Menu items - public read, kitchen staff write
    match /menu_items/{document=**} {
      allow read: if true;
      allow write: if isKitchenStaff();
    }

    // Orders - authenticated users & guests create, users read own, kitchen staff read all
    match /orders/{orderId} {
      // List: Allow users to query their own orders, kitchen staff to query all
      allow list: if isKitchenStaff() ||
                    (isAuthenticated() && 
                     query.where('userId', '==', request.auth.uid).exists());

      // Read: Owner, guest order creator, kitchen staff, or ANYONE for active orders (needed for crowd status)
      allow read: if isOwner(resource.data.userId)
                    || resource.data.userId == 'guest'
                    || resource.data.userId.startsWith('guest_')
                    || isKitchenStaff()
                    || (resource.data.status in ['kitchen_received', 'preparing', 'ready']);

      // Create: Authenticated, guest, or test user
      allow create: if isAuthenticated()
                       || isGuestOrder()
                       || isTestOrder();

      // Update: 
      // 1. Kitchen Staff: Can update anything (status, etc.)
      // 2. Owner: Can ONLY cancel orders, and ONLY if status is 'pending' or 'kitchen_received'
      allow update: if isKitchenStaff() || 
                    (isOwner(resource.data.userId) && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                     request.resource.data.status == 'cancelled' &&
                     resource.data.status in ['pending', 'kitchen_received']);
    }

    // User profiles - owners read/write own, kitchen staff can read
    match /users/{userId} {
      allow read: if isOwner(userId) || isKitchenStaff();
      
      // Create: Allow if not trying to set kitchenStaff to true
      allow create: if isOwner(userId) && 
                    (!request.resource.data.keys().hasAny(['kitchenStaff']) || request.resource.data.kitchenStaff == false);
      
      // Update: Allow if not touching kitchenStaff
      allow update: if isOwner(userId) && 
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kitchenStaff']));

      // Kuro AI Sessions
      match /kuro_sessions/{sessionId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Meal Plans
      match /meal_plans/{planId} {
        allow read, write: if request.auth.uid == userId;
      }

      // User Preferences
      match /preferences/{prefId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Campus status
    match /campus_status/{document=**} {
      allow read: if true;
      allow write: if isKitchenStaff();
      
      // Allow automated updates from clients only for operational metrics
      allow update: if (isAuthenticated() || request.auth == null) && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'dailyOrderCount', 
                      'lastOrderReset',
                      'activeOrders',
                      'activeOrderIds',
                      'averagePrepTime',
                      'totalPrepTimeRemaining',
                      'crowdLevel',
                      'crowdScore',
                      'estimatedWait',
                      'lastUpdated'
                    ]);
    }

    // FCM Tokens - separate collection to support authenticated users
    match /fcm_tokens/{userId} {
      allow read: if isOwner(userId) || isKitchenStaff();
      allow write: if isOwner(userId);
    }
  }
}

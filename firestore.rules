rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isKitchenStaff() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.kitchenStaff == true;
    }

    function isGuestOrder() {
      return request.resource.data.userId == 'guest' || 
             request.resource.data.userId.matches('^guest_.*');
    }

    // Allow test orders for unauthenticated users (for testing Phase 4)
    function isTestOrder() {
      // Check if userId exists and matches pattern, safe navigation
      return request.resource.data.keys().hasAll(['userId']) && 
             request.resource.data.userId.matches('^test-user-.*');
    }

    // Menu items - public read, kitchen staff write
    match /menu_items/{document=**} {
      allow read: if true;
      allow write: if isKitchenStaff();
    }

    // Orders - authenticated users & guests create, users read own, kitchen staff read all
    match /orders/{orderId} {
      // Read: Owner, guest order creator, kitchen staff, or ANYONE for active orders (needed for crowd status)
      allow read: if isOwner(resource.data.userId)
                    || resource.data.userId == 'guest'
                    || resource.data.userId.startsWith('guest_')
                    || isKitchenStaff()
                    || (resource.data.status in ['kitchen_received', 'preparing', 'ready']);

      // Create: Authenticated, guest, or test user (for Phase 4 testing)
      allow create: if isAuthenticated()
                       || isGuestOrder()
                       || isTestOrder();

      // Update: Kitchen staff, or owner for cancellation, or anyone for status if it's needed (but usually kitchen only)
      allow update: if isKitchenStaff() || isOwner(resource.data.userId);
    }

    // User profiles - owners read/write own, kitchen staff can read
    match /users/{userId} {
      allow read: if isOwner(userId) || isKitchenStaff();
      allow write: if isOwner(userId); // Covers create and update
    }

    // Campus status - kitchen staff write, public read
    // All users (including guests) can update dailyOrderCount when creating orders
    // and update crowd intelligence fields
    match /campus_status/{document=**} {
      allow read: if true;
      // Kitchen staff can do any write
      allow write: if isKitchenStaff();
      // All users can update specific fields: 
      // 1. Order counter (for transactions in createOrder)
      // 2. Crowd status fields (for updateCrowdStatus)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'dailyOrderCount', 
        'lastOrderReset',
        'activeOrders',
        'activeOrderIds',
        'averagePrepTime',
        'totalPrepTimeRemaining',
        'kitchenCapacity',
        'staffOnline',
        'crowdLevel',
        'crowdScore',
        'estimatedWait',
        'isManualOverride',
        'calculationMethod',
        'lastUpdated'
      ]);
    }

    // FCM Tokens - separate collection to support authenticated users
    match /fcm_tokens/{userId} {
      allow read: if isOwner(userId) || isKitchenStaff();
      allow write: if isOwner(userId);
    }
  }
}
